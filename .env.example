# QuestionForge 环境变量示例
# 用法：复制为 .env（或直接在启动命令前设置），未设置的项一律使用括号里的默认值。
# 注意：.env 含密钥，已在 .gitignore 中排除，切勿提交。

# ---------- 服务 ----------
QF_PORT=8540                     # HTTP 端口（默认 8540）
QF_LOG_LEVEL=info                # debug | info | warn | error（默认 info）
QF_LOG_DIR=./data/logs           # 结构化日志按天落地目录；设为 off 则只输出到控制台
QF_LOG_PRETTY=0                  # 1 = 控制台输出人类可读行（默认：非 TTY 时自动开启 JSON 行）

# ---------- MySQL ----------
QF_DB_HOST=127.0.0.1
QF_DB_PORT=3306
QF_DB_USER=root
QF_DB_PASSWORD=123456            # 生产环境请改成专用账号的强口令
QF_DB_NAME=questionforge         # 测试可用 questionforge_test 与生产隔离
QF_DB_POOL=10                    # 连接池上限

# ---------- 安全 ----------
QF_SECURE_COOKIE=1               # 1 = Cookie 带 Secure（HTTPS 部署时开启；仅 HTTP 访问时不要开）
QF_RATELIMIT=                    # off = 关闭接口限流（仅供自动化测试，勿在生产设置）

# ---------- 成本与流水线 ----------
QF_CONTEXT_BUDGET=8000           # 每批出题注入的资料片段字符预算（按考点分块检索后的上限）
QF_FIG_BUDGET=4000               # 每批注入的"资料附图（识图结果）"字符预算
QF_DUP_THRESHOLD=0.62            # 近似重复题判定阈值（依据见 simcal.js 的标定表）

# ---------- 测试专用（勿在生产设置） ----------
QF_MOCK=                         # 1 = 使用模拟模型响应，仅测试用
QF_DATA_DIR=                     # 独立数据目录（测试隔离文件用）
QF_TEST_DB=questionforge_test    # runtests.js 使用的测试库名
